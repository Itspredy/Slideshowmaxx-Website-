# Keep real values in .env.local or your hosting provider's secret settings.
# Test first. Use live_mode only after your merchant account and products are approved.
DODO_MODE=test_mode
DODO_LIVE_ENABLED=false
DODO_PAYMENTS_API_KEY=
DODO_REGULAR_PRODUCT_ID=
DODO_OFFER_PRODUCT_ID=
PUBLIC_SITE_URL=http://localhost:3000

# Share a Google Sheet with this service account's email as Editor.
# Create a tab named Orders with the headers documented in README.md.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Orders
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
